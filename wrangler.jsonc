{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lich-papers",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true },
  // Daily: drop cached paper full text past its 24h lifetime.
  "triggers": { "crons": ["17 4 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      // No database_id: `wrangler deploy` auto-provisions a D1 database with this name on first deploy.
      "database_name": "lich-papers",
      "migrations_dir": "migrations"
    }
  ],
  // Workers AI, for the optional shared decision model (Clef). Only used when DECISION_BACKEND is "workers-ai".
  "ai": { "binding": "AI" },
  "vars": {
    "APP_NAME": "Lich Papers",
    "DEFAULT_MODEL": "openrouter/free",
    // Pro plan: $10/month, with each subscriber's model spend capped at $4/month on their own OpenRouter key.
    "PRO_PRICE_CENTS": "1000",
    "PRO_MONTHLY_CAP_USD": "4",
    "PRO_DEFAULT_MODEL": "google/gemini-2.5-flash",
    // One-time trial on the shared OPENROUTER_API_KEY, in messages.
    "FREE_TRIAL_MESSAGES": "10",
    // Shared decision model for every signed-in user: Clef (27B) on Workers AI, billed to this account.
    "DECISION_BACKEND": "workers-ai",
    "DECISION_MODEL": "clef"
  }
  // Secrets (set with `wrangler secret put`):
  //   ENCRYPTION_KEY       – required; base64 32-byte key used to encrypt stored API keys
  //   OPENROUTER_API_KEY   – optional; server key for a one-time free trial on the free router
  //   STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, OPENROUTER_PROVISIONING_KEY – required for the Pro plan
  // Shown in the Terms and Privacy Policy (set as plain vars in the dashboard):
  //   OPERATOR_NAME        – e.g. "Jane Doe"; CONTACT_EMAIL – privacy/takedown address; GOVERNING_LAW – e.g. "the State of Texas, USA"
  //   COMP_PRO_USER_IDS    – optional; comma-separated account IDs that get Pro for free (needs OPENROUTER_PROVISIONING_KEY)
  // Shared decision model (optional; Clef) for users who haven't picked their own. Either:
  //   DECISION_BACKEND = "workers-ai" – var; runs on Workers AI via the AI binding, billed to this account
  //                                     (Clef Flash $0.09 / Clef $0.24 per M input tokens, no output charge)
  //   DECISION_OLLAMA_KEY  – or a secret; Ollama Cloud key that pays for it (DECISION_OLLAMA_BASE – var; default https://ollama.com)
  //   DECISION_MODEL       – var; "clef-flash" (default) or "clef"
}
