{
  "name": "lich-papers",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy && wrangler d1 migrations apply lich-papers --remote",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply lich-papers --local",
    "db:migrate:remote": "wrangler d1 migrations apply lich-papers --remote",
    "cf-typegen": "wrangler types",
    "setup:local": "wrangler d1 migrations apply lich-papers --local && node scripts/dev-vars.mjs"
  },
  "dependencies": {
    "@moikapy/lich": "^0.9.0",
    "dompurify": "^3.4.16",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "katex": "^0.18.10",
    "marked": "^18.1.0",
    "marked-katex-extension": "^5.1.13",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
